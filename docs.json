{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Ulysses Documentation",
  "colors": {
    "primary": "#0F3D3E",
    "light": "#1F6F70",
    "dark": "#0A2A2B"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "seo": {
    "metatags": {
      "canonical": "https://docs.tryulysses.com"
    }
  },
  "navigation": {
    "pages": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "use-cases/overview"
        ]
      },
      {
        "group": "CLI",
        "pages": [
          "cli/install",
          "cli/auth",
          "cli/commands",
          "cli/agents"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/overview"
        ]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/overview",
          "guides/create-a-project",
          "guides/match-opportunities"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "App",
          "href": "https://app.tryulysses.com",
          "icon": "arrow-up-right-from-square"
        },
        {
          "anchor": "Website",
          "href": "https://tryulysses.com",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://docs.tryulysses.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@tryulysses.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.tryulysses.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/tryulysses",
      "github": "https://github.com/UlyssesBusinessCorporation"
    }
  }
}
